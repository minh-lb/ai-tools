<?php declare(strict_types=1);

use Modules\{Module}\Application\DTOs\{Name}DTO;
use Modules\{Module}\Application\EventHandlers\{EventName}Handler;
use Modules\{Module}\Application\UseCases\{Name}UseCase;
use Modules\{SourceModule}\Domain\Events\{EventName};

uses(Tests\TestCase::class);

test('{event_name} maps the stable event to the application flow', function (): void {
    $useCase = Mockery::mock({Name}UseCase::class);
    $useCase->shouldReceive('handle')
        ->once()
        ->with(Mockery::on(
            fn ({Name}DTO $dto): bool => $dto->id === 'entity-123',
        ));

    $handler = new {EventName}Handler($useCase);
    $handler->handle(new {EventName}(
        eventId: 'event-123',
        occurredAt: new DateTimeImmutable('2025-01-01T00:00:00+00:00'),
        entityId: 'entity-123',
    ));
});

