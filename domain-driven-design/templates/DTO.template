<?php declare(strict_types=1);

namespace Modules\{Module}\Application\DTOs;

/**
 * Example application input shape. Call fromArray() only after the trusted entry
 * boundary has validated the input, and map every field according to its real type.
 */
class {Name}DTO
{
    public function __construct(
        public readonly string $id,
    ) {}

    public static function fromArray(array $validatedData): self
    {
        return new self(
            id: $validatedData['id'],
        );
    }
}
