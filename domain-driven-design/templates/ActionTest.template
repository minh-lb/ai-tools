<?php declare(strict_types=1);

use Modules\{Module}\Domain\Actions\{Action}Action;
use Modules\{Module}\Domain\Entities\{Entity};
use Modules\{Module}\Domain\Repositories\{Entity}Repository;

uses(Tests\TestCase::class); // Use the project's test base and mock teardown convention.

test('{action} applies the requested business rule and persists the result', function (): void {
    $entity = new {Entity}(id: 'entity-123');
    $repository = Mockery::mock({Entity}Repository::class);
    $repository->shouldReceive('find')->once()->with('entity-123')->andReturn($entity);
    $repository->shouldReceive('save')->once()->with($entity);

    $result = (new {Action}Action($repository))->execute(id: 'entity-123');

    expect($result)->toBeInstanceOf({Entity}::class);
});
