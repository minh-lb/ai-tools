<?php declare(strict_types=1);

namespace Modules\Shared\Support\Http;

use Illuminate\Http\JsonResponse;

/**
 * Optional example only. Use or adapt it only when the approved API contract
 * already defines this envelope; do not introduce a response wrapper by default.
 */
final class ApiResponse
{
    public static function success(
        int $status,
        string $code,
        array|null $data = null,
        string|null $message = null,
    ): JsonResponse {
        return response()->json([
            'success' => true,
            'code' => $code,
            'message' => $message,
            'data' => $data,
        ], $status);
    }

    public static function problem(
        int $status,
        string $code,
        string|null $message = null,
        array $errors = [],
    ): JsonResponse {
        return response()->json([
            'success' => false,
            'code' => $code,
            'message' => $message,
            'errors' => $errors,
        ], $status);
    }
}
